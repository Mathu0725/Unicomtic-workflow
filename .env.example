# ==============================================================================
# Unicom TIC Student Lifecycle Management Platform - Environment Variables
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server security (required in production; use your admissions Gmail as ADMIN_EMAIL)
APP_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional local data directory. Use Supabase when deploying to a serverless host.
# DATA_DIR=
# ALLOW_LOCAL_STORAGE=true
SEED_DEMO_DATA=false

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# Default SMTP Settings (Overrides configurable via Admin UI Email Center)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admissions@unicomtic.org
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Unicom TIC Admissions
SMTP_FROM_EMAIL=admissions@unicomtic.org

# Google API Credentials (Service Account & OAuth)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Sheets IDs for Auto-Sync
GOOGLE_REGISTRATIONS_SHEET_ID=
GOOGLE_APPLICATIONS_SHEET_ID=

# Background Job Worker Secret (for invoking /api/cron/process-queue)
CRON_SECRET=
# Run npm run worker alongside the app, or schedule the protected queue endpoint.
# WORKER_APP_URL=http://localhost:3000
# Vercel Hobby: schedule the protected endpoint from Supabase Cron every minute.
# See docs/VERCEL_HOBBY_SETUP.md. Do not run a persistent worker inside Vercel.
# Optional raw AES key for preserving existing encrypted Google/SMTP credentials.
# On this development installation, securely copy .data/secret.key into APP_DATA_KEY
# in Vercel's server environment. Never publish the key or hash it again.
# APP_DATA_KEY=<64 hexadecimal characters>

# Production first-time empty database initialization only. Remove/disable after setup.
# Existing initialized local storage is never reset when its snapshot is missing.
ALLOW_DATABASE_INITIALIZE=false
